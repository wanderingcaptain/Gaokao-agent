# 模型适配层：默认使用 Qwen；可改为 deepseek 或 ollama
LLM_PROVIDER=qwen
# 显式关闭思考以保持基线预算；开启前确认所选模型支持
LLM_THINKING=false
LLM_TIMEOUT_SECONDS=60
# 可选：模型网关绕过代理的主机名，多个用逗号分隔，按主机名精确匹配
# LLM_NO_PROXY=myai.bupt.edu.cn
# V2 网上调查（可选，未配置时明确返回搜索不可用，不生成假资料）
# TAVILY_API_KEY=
# 由维护者审查的官方域名；不在名单中的来源仅作为待核实补充资料
RESEARCH_OFFICIAL_DOMAINS=eea.gd.gov.cn
# 可选通用覆盖项（优先于下面对应供应商配置；不要同时配置不匹配的地址和密钥）
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=

# 通义千问 API Key
QWEN_API_KEY=your_api_key_here
# 通义千问 API Base URL
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 调用的模型名称
QWEN_MODEL=qwen-plus

# DeepSeek 配置：只有 LLM_PROVIDER=deepseek 时使用，不回退到 Qwen 密钥
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro

# 本机 Ollama（LLM_PROVIDER=ollama 时使用）
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_API_KEY=  # 只有非本机地址需要配置

# Agent 编排参数
# Agent 每次决策可调用工具，超过上限后自动回退到规则备选结果
AGENT_MAX_STEPS=24
AGENT_PAGE_SIZE=60
# V2 默认随 API 启动数据库队列执行器；改为 false 时需单独运行 python -m services.run_worker
AGENT_EMBEDDED_WORKER=true

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 数据库路径（相对于 backend/ 目录）
DATABASE_URL=sqlite:///./database/gaokao.db

# 用户画像存储目录（相对于 backend/ 目录）
PROFILES_DIR=./profiles

# 登录认证
JWT_SECRET_KEY=please_change_this_secret
JWT_EXPIRE_MINUTES=10080
